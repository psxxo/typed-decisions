{
  "name": "@psxxo/typed-decisions",
  "version": "1.3.0",
  "description": "System One typed decision provider for OpenClaw's decisionModel role: choice / score / boolean judgments with probability distributions.",
  "type": "module",
  "license": "MIT",
  "files": [
    "index.js",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "src",
    "dist"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "decision-model",
    "decision",
    "rubric",
    "classification",
    "scoring",
    "system-one"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psxxo/typed-decisions.git"
  },
  "homepage": "https://clawhub.ai/psxxo/plugins/typed-decisions",
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit",
    "build:check": "node scripts/build-ui.mjs --check"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.9.6",
      "minGatewayVersion": "2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6",
      "pluginSdkVersion": "2026.9.6"
    }
  }
}
